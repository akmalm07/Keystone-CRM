# Core application
PORT=8080
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRATION=7d
PASSWORD_RESET_SECRET=replace-with-a-second-long-random-value
TEMP_TOKEN_EXPIRATION=15m

# AI drafts and lead scoring
OPENAI_API_KEY=

# Gmail integration (optional until Gmail is connected)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback
GMAIL_TOPIC=

# SMS delivery (optional until SMS is connected)
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=
