meta {
  name: Verify entry details
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/get-group
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "{{groupName}}",
    "entry_details": { "invite_code": "bruno-code" }
  }
}

tests {
  test("accepts configured invite code", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.group.id).to.equal(bru.getVar("groupId"));
  });
}
