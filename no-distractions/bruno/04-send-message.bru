meta {
  name: Send message
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/send-chats
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "group_id": "{{groupId}}",
    "message_body": "A focused message from Bruno."
  }
}

tests {
  test("stores a message", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.body.message.body).to.equal("A focused message from Bruno.");
  });
}
