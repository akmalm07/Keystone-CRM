meta {
  name: Register prototype user
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/register
  body: json
  auth: none
}

body:json {
  {
    "username": "bruno{{$randomInt}}",
    "password": "verysecurepassword"
  }
}

tests {
  test("creates user and session", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.body.user.username).to.match(/^bruno/);
    expect(res.body.token).to.be.a("string");
    bru.setVar("token", res.body.token);
  });
}
