meta {
  name: Create group
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/create-group
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "Bruno Group {{$randomInt}}",
    "entry_details_config": { "invite_code": "bruno-code" }
  }
}

tests {
  test("creates unique group and membership", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.body.group.id).to.be.a("string");
    expect(res.body.subdomain).to.contain(".nodistractions.online");
    bru.setVar("groupId", res.body.group.id);
    bru.setVar("groupName", res.body.group.name);
  });
}
