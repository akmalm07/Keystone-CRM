meta {
  name: Read chat history
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/get-chats
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "group_id": "{{groupId}}" }
}

tests {
  test("returns the sent message", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.body.messages).to.have.length(1);
    expect(res.body.messages[0].body).to.equal("A focused message from Bruno.");
  });
}
